# autormm agent — systemd *user* service for GRAPHICAL Linux desktops.
# Runs inside your login session so it can capture the screen (X11) and inject
# input via XTEST.
#
# Install:
#   cp to ~/.config/systemd/user/
#   loginctl enable-linger $USER          # so it runs without an active TTY
#   systemctl --user enable --now autormm-agent-user
[Unit]
Description=autormm agent (desktop session)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
EnvironmentFile=%h/.config/autormm/agent.env
# These two are the whole trick, and :0 with ~/.Xauthority is only the common
# case: under GDM the authority file is /run/user/<uid>/gdm/Xauthority, and a
# session that was not the first on its seat is on :1. Read the real pair with
#   loginctl show-session "$(loginctl show-user $USER -p Display --value)" -p Type -p Display
#   echo "$XAUTHORITY"   # from a terminal on the desktop itself
# or let the hub's one-command desktop installer detect them for you.
# (X11/Xwayland only; native Wayland capture is not supported.)
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=%h/.local/bin/autormm-agent
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
